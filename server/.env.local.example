# Local-only overrides. Copy to server/.env.local; local launch scripts load it
# before server/.env so local database and queue settings take precedence.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/codeguard_local
REDIS_URL=redis://127.0.0.1:6379
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=loopback

# For local sign-in, use a separate OAuth App configured with this exact callback.
GITHUB_OAUTH_CALLBACK_URL=http://localhost:5000/api/auth/github/callback
# Put the local OAuth App client ID and secret in server/.env.local.

# Local App authorization needs an App configured for local callback/setup URLs.
# Put that App's ID, client values and private-key path in server/.env.local.
GITHUB_APP_CALLBACK_URL=http://localhost:5000/api/github/app/callback
