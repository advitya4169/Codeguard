# Shared by the Render Web Service and Background Worker
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
REDIS_URL=redis://localhost:6379
GROQ_API_KEY=<groq-api-key>

# Backend Web Service
PORT=5000
NODE_ENV=development
JWT_SECRET=<long-random-secret>
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# Local: loopback. For Render, set the verified proxy hop count instead.
TRUST_PROXY_HOPS=loopback

# GitHub OAuth App for CodeGuard sign-in
GITHUB_CLIENT_ID=<oauth-client-id>
GITHUB_CLIENT_SECRET=<oauth-client-secret>

# GitHub App integration
GITHUB_APP_ID=<github-app-id>
GITHUB_APP_PRIVATE_KEY_PATH=/etc/secrets/codeguard-private-key.pem
# Alternatively, use GITHUB_APP_PRIVATE_KEY with escaped \n characters.
GITHUB_APP_CLIENT_ID=<github-app-client-id>
GITHUB_APP_CLIENT_SECRET=<github-app-client-secret>
GITHUB_APP_INSTALL_URL=https://github.com/apps/<app-slug>/installations/new
GITHUB_APP_CALLBACK_URL=https://<your-backend-domain>/api/github/app/callback
WEBHOOK_SECRET=<github-app-webhook-secret>
